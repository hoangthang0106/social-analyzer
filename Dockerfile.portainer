FROM node:22-bookworm-slim
WORKDIR /usr/src/app
RUN apt-get update && apt-get install -y --no-install-recommends firefox-esr ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY . .
RUN mkdir -p /usr/src/app/logs && chown -R node:node /usr/src/app
USER node
EXPOSE 18898
CMD ["npm", "start", "--", "--docker"]
